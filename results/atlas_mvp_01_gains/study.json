{
  "name": "atlas_mvp_01_gains",
  "description": "PX4 attitude and rate gains plus hover thrust for ATLAS_MVP_01's slow ducted fans (tau 0.12 s): minimise hover attitude activity and position wobble. CMA-ES, 40 runs.",
  "airframe": "airframes/atlas_mvp_01.json",
  "scenario": "hover",
  "variables": [
    {
      "path": "px4.MC_PITCH_P",
      "range": [
        1.5,
        8.0
      ]
    },
    {
      "path": "px4.MC_PITCHRATE_P",
      "range": [
        0.03,
        0.4
      ]
    },
    {
      "path": "px4.MC_PITCHRATE_D",
      "range": [
        0.0,
        0.01
      ]
    },
    {
      "path": "px4.MC_ROLL_P",
      "range": [
        1.5,
        8.0
      ]
    },
    {
      "path": "px4.MC_ROLLRATE_P",
      "range": [
        0.03,
        0.4
      ]
    },
    {
      "path": "px4.MPC_THR_HOVER",
      "range": [
        0.25,
        0.6
      ]
    }
  ],
  "objective": "phases.hover.pitch_rms_deg + phases.hover.roll_rms_deg + 0.02 * phases.hover.rates_rms_deg_s + 2 * phases.hover.pos_std_xy + 5 * phases.hover.alt_std",
  "constraints": [
    "not metrics.crashed",
    "ok"
  ],
  "penalty": 200,
  "algorithm": {
    "name": "cmaes",
    "budget": 40,
    "population": 8,
    "sigma": 0.35,
    "seed": 1
  },
  "workers": 4,
  "sim": {
    "instances": [
      2,
      3,
      4,
      5
    ],
    "substeps": 2
  }
}