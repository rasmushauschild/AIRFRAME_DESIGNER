{
  "name": "08B nose takeoff, 50 km/h cruise, nose landing",
  "description": "SITL PX4 velocity control with gradual speed ramps, altitude feedback and supported nose landing. 100 km/h trim is not validated.",
  "max_time": 300,
  "abort": {
    "max_tilt_deg": 65,
    "max_alt": 30,
    "crash_speed": 3
  },
  "phases": [
    {
      "type": "wait_ready",
      "timeout": 40
    },
    {
      "type": "nose_lift",
      "motors": [
        4,
        5,
        6
      ],
      "rate_deg_s": 4,
      "timeout": 40
    },
    {
      "type": "takeoff",
      "alt": 10,
      "timeout": 40
    },
    {
      "type": "hold",
      "duration": 10
    },
    {
      "type": "cruise_velocity",
      "name": "accelerate_50",
      "speed": 13.88888888888889,
      "duration": 28,
      "ramp": 0.6
    },
    {
      "type": "cruise_velocity",
      "name": "cruise_50",
      "speed": 13.88888888888889,
      "duration": 15,
      "ramp": 0.6
    },
    {
      "type": "cruise_velocity",
      "name": "decelerate",
      "speed": 0,
      "duration": 28,
      "ramp": 0.6
    },
    {
      "type": "cruise_velocity",
      "name": "hover_final",
      "speed": 0,
      "duration": 10,
      "ramp": 0.6
    },
    {
      "type": "nose_land",
      "motors": [
        4,
        5,
        6
      ],
      "descent_speed": 0.4,
      "rate_deg_s": 3,
      "timeout": 90
    }
  ]
}
