{
  "name": "08B nose takeoff, 50 km/h cruise, nose landing",
  "description": "SITL PX4 velocity control with gradual speed ramps, altitude feedback and supported nose landing. 100 km/h trim is not validated.",
  "max_time": 300,
  "abort": {
    "max_tilt_deg": 65,
    "max_alt": 30,
    "crash_speed": 3
  },
  "phases": [
    {
      "type": "wait_ready",
      "timeout": 40
    },
    {
      "type": "module",
      "action": "takeoff",
      "timeout": 40
    },
    {
      "type": "hold",
      "duration": 10
    },
    {
      "type": "cruise_velocity",
      "name": "accelerate_50",
      "speed": 13.88888888888889,
      "duration": 28,
      "ramp": 0.6
    },
    {
      "type": "cruise_velocity",
      "name": "cruise_50",
      "speed": 13.88888888888889,
      "duration": 15,
      "ramp": 0.6
    },
    {
      "type": "cruise_velocity",
      "name": "decelerate",
      "speed": 0,
      "duration": 28,
      "ramp": 0.6
    },
    {
      "type": "cruise_velocity",
      "name": "hover_final",
      "speed": 0,
      "duration": 10,
      "ramp": 0.6
    },
    {
      "type": "module",
      "action": "land",
      "timeout": 90
    }
  ]
}
